# .dockerignore — controls what is sent to the Docker build context
#
# Files listed here are NOT sent to the Docker daemon when `docker build` runs.
# A smaller build context means:
#   - Faster context transfer (especially important in CI)
#   - No risk of accidentally COPYing secrets or test data into the image
#   - COPY instructions that use wildcards (e.g. COPY . .) are not polluted
#     by unrelated files

# ── Version control ───────────────────────────────────────────────────────────
.git
.gitignore
.github

# ── Python cache and compiled files ──────────────────────────────────────────
__pycache__
*.pyc
*.pyo
*.pyd
.Python
*.egg-info
dist/
build/
.eggs/

# ── Test and coverage artefacts ───────────────────────────────────────────────
tests/
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# ── Documentation and project files ──────────────────────────────────────────
README.md
docs/
devops-setup/
scripts/
*.md
!README.md

# ── Node.js dependencies and build output ────────────────────────────────────
node_modules
npm-debug.log
backend/node_modules
frontend/node_modules
backend/dist
frontend/dist

# ── Kiro spec and test artefacts ─────────────────────────────────────────────
.kiro/
coverage/

# ── Local development and editor files ───────────────────────────────────────
.env
.env.*
*.env
.venv
venv/
.idea/
.vscode/
*.swp
*.swo

# ── OS-generated files ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
